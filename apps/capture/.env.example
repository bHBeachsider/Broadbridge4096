# Dedicated Broadbridge Neon branch only. Never use PermitHub's connection.
BROADBRIDGE_DATABASE_URL=
AUTH_SECRET=
RESEND_API_KEY=
CAPTURE_ALLOWED_EMAILS=
# Verified Resend sender, e.g. Broadbridge <capture@your-verified-domain>
CAPTURE_EMAIL_FROM=
# Local development only. Vercel provides its deployment origin automatically.
AUTH_URL=http://localhost:3000
# Test interception is local development only; never configure this on Vercel.
# CAPTURE_TEST_OUTBOX=/absolute/temporary/test-outbox.json
# Private R2 incoming storage. No ambient AWS credential fallback.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# HTTPS CPU ingestion service; tokens remain on the server.
INGESTION_API_URL=
INGESTION_API_TOKEN=
# Disposable local integration only, never Vercel. Requires NODE_ENV=development,
# loopback AUTH_URL/database/services and database name beginning broadbridge_test.
# CAPTURE_LOCAL_INGESTION_TEST=1
# CAPTURE_TEST_SQL_ENDPOINT=http://127.0.0.1:PORT/sql
# R2 CORS must permit the capture origin, PUT, content-type, if-none-match,
# x-amz-meta-sha256, x-amz-meta-source-id, x-amz-meta-revision-id.
