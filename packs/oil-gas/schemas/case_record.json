{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://broadbridge.invalid/form/case_record.json",
  "title": "Interview Guide Part B case record",
  "description": "B1-B6 are decision-time; B7-B13 are hindsight; B14 is reference evidence. unknown is allowed for all captured answers. Containers retain object/array structure. Blanks are null or empty arrays and are listed in form_review.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "family_id",
    "status",
    "identity",
    "decision_time",
    "hindsight",
    "b14_evidence",
    "questions",
    "reviewer_signoff",
    "source"
  ],
  "properties": {
    "schema": {
      "const": "broadbridge.case_form/1"
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "family_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "pending_review",
        "signed"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "unit_service",
        "period",
        "confidentiality",
        "record_type",
        "permitted_use"
      ],
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit_service": {
          "type": [
            "string",
            "null"
          ]
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidentiality": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_type": {
          "enum": [
            "real_event",
            "reconstructed",
            "hypothetical",
            "unknown",
            null
          ]
        },
        "permitted_use": {
          "enum": [
            "training",
            "testing_only",
            "reference_only",
            "undecided",
            "unknown",
            null
          ]
        }
      }
    },
    "decision_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b1_trigger",
        "b2_operating_context",
        "b3_initial_info_and_requests",
        "b5_initial_hypotheses",
        "b6_distrusted_or_missing",
        "b4_observations"
      ],
      "properties": {
        "b1_trigger": {
          "type": [
            "string",
            "null"
          ]
        },
        "b2_operating_context": {
          "type": [
            "string",
            "null"
          ]
        },
        "b3_initial_info_and_requests": {
          "type": [
            "string",
            "null"
          ]
        },
        "b5_initial_hypotheses": {
          "type": [
            "string",
            "null"
          ]
        },
        "b6_distrusted_or_missing": {
          "type": [
            "string",
            "null"
          ]
        },
        "b4_observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time",
              "variable_location",
              "value_units_basis",
              "source",
              "quality"
            ],
            "properties": {
              "time": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "variable_location": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "value_units_basis": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quality": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "hindsight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b8_turning_point",
        "b9_calculations",
        "b10_actions_taken",
        "b11_confidence",
        "b12_dangerous_wrong_answer",
        "b13_lesson_and_limits",
        "b7_hypotheses"
      ],
      "properties": {
        "b8_turning_point": {
          "type": [
            "string",
            "null"
          ]
        },
        "b9_calculations": {
          "type": [
            "string",
            "null"
          ]
        },
        "b10_actions_taken": {
          "type": [
            "string",
            "null"
          ]
        },
        "b11_confidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "b12_dangerous_wrong_answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "b13_lesson_and_limits": {
          "type": [
            "string",
            "null"
          ]
        },
        "b7_hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hypothesis",
              "evidence_for",
              "evidence_against",
              "discriminator"
            ],
            "properties": {
              "hypothesis": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_for": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_against": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "discriminator": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "b14_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "format",
          "available_at_decision_time",
          "restriction"
        ],
        "properties": {
          "item": {
            "type": [
              "string",
              "null"
            ]
          },
          "format": {
            "type": [
              "string",
              "null"
            ]
          },
          "available_at_decision_time": {
            "type": [
              "string",
              "null"
            ]
          },
          "restriction": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "eval_question.json"
      }
    },
    "reviewer_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed",
        "reviewer_signature",
        "interviewer_signature",
        "approval_basis"
      ],
      "properties": {
        "signed": {
          "type": "boolean"
        },
        "reviewer_signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "interviewer_signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_basis": {
          "enum": [
            "pending_review",
            "operator_attestation"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256"
      ],
      "properties": {
        "filename": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
